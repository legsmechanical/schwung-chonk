import("onetrick.lib");

mixGain = ba.db2linear(max(-100, hslider("[110]Mix_Gain[group:Mix][export:Gain][unit:dB]", 0, -100, 6, 0.1) ) : ot.smoothParam);
mixPan = hslider("[120]Mix_Pan[group:Mix][export:Pan][unit:%]", 0, -100, 100, 0.01) * 0.01 : ot.smoothParam;
mixSaturation = hslider("[130]Mix_Saturation[group:Mix][export:Saturation][unit:%]", 0, 0, 100, 0.01) * 0.01;

pickupPos01 = hslider("[210]Pickup_Position[group:Bass][export:Pickup Position][unit:%]", 50, 0, 100, 0.01) / 100;
sustain = it.interpolate_linear(ot.input.modWheel, hslider("[220]Sustain[group:Bass][export:Sustain][unit:%]", 100, 0, 100, 0.01) / 100, -1);
stringBrightness = hslider("[230]Brightness[group:Bass][export:String Brightness][unit:%]", 50, 0, 100, 0.01) / 100;
strikeHardness = hslider("[240]StrikeHardness[group:Bass][export:Strike Hardness][unit:%]", 0, 0, 100, 0.01) / 100;
mixThump = hslider("[250]Bass_Thump[group:Bass][export:Thump][unit:%]", 50, 0, 100, 0.01) / 100 * 3.0;
toneKnob01 = hslider("[260]Tone_Knob[group:Bass][export:Tone Knob][unit:%]", 50, 0, 100, 0.01) / 100;
toneKnob = ot.interpolate_freq(toneKnob01, 300, 2500);

// ── SCHWUNG PORT ADDITION (not upstream) ───────────────────────────────────
// Ring: how much the string is allowed to keep ringing after the key is
// released. 0 = upstream's behaviour exactly (the release damps the string to
// bounceEfficiencyMuted), 100 = the release does not damp at all and the note
// decays at its own sustain. Read by bass.dsp's bounceEfficiency.
ringAmount = hslider("[270]Ring[group:Bass][export:Ring][unit:%]", 0, 0, 100, 0.01) / 100;
// The Ring/Gate articulation overrides the knob while engaged — a let-ring
// gesture, the way a sustain pedal is, rather than another value to dial in.
ringTerm = max(ringAmount, articulationRing);

fineTune = hslider("[310]Fine_Tune[group:MIDI][export:Fine Tune][unit:c]", 0, -100, 100, 0.01) / 100 : ot.smoothParam : ba.semi2ratio;
midiAftertouchRange = hslider("[320]Midi_Afterouch_range[group:MIDI][export:Aftertouch Range][unit:st]", 1, -2, 2, 0.01);
midiPitchWheelRange = hslider("[330]Midi_PitchWheel_range[group:MIDI][export:PitchWheel Range][unit:st]", 2, 0, 12, 0.01);

//toneKnob01 = it.interpolate_linear(ot.input.modWheel, hslider("[220]Tone_Knob[group:Bass][export:Tone Knob][unit:%]", 50, 0, 100, 0.01) / 100, 1);

articulationMute = button("Articulation_Mute") : ot.smoothParamFast;

articulationFinger = button("Articulation_Finger") : ot.smoothParamFast;
articulationPick = button("Articulation_Pick") : ot.smoothParamFast;
articulationSlap = button("Articulation_Slap") : ot.smoothParamFast : max(articulationSlapAuto);
articulationSlapAuto = ot.input.velocity : it.remap(0.85, 1.0, 0, 1) : max(0) : pow(_, 1.5);

articulationStyleAmount = articulationFinger : max(articulationPick) : max(articulationSlap);
articulationStyleHardness = max(articulationPick * 1/2, articulationSlap);

articulationSlide = (nentry("Articulation_SlideUp",0,0,1,0.01) - nentry("Articulation_SlideDown",0,0,1,0.01)) * 48;
articulationLegato = button("Articulation_Legato") : ot.smoothParamFast;

// SCHWUNG PORT ADDITION (not upstream): the Ring/Gate toggle.
articulationRing = button("Articulation_Ring") : ot.smoothParamFast;

// ── SCHWUNG PORT ADDITION (not upstream) ───────────────────────────────────
// Upstream's Legato does three things at once: it glides the pitch, it frets
// that glide, and it takes the click and the finger out of the output. These
// two switches break the first two out so they can be had on their own.
//
// glideTerm keeps Legato implying glide, so Legato sounds exactly as it always
// has; Glide adds the slide WITHOUT losing the click.
articulationGlide = button("Articulation_Glide") : ot.smoothParamFast;
glideTerm = max(articulationLegato, articulationGlide);

// How long the glide takes, as a T60. Upstream hard-coded 35 ms, which is the
// default here, so an untouched patch glides exactly as it always did. The
// time is multiplied by glideTerm in bass.dsp, so with neither Glide nor
// Legato engaged the time is 0 and the pitch jumps, whatever this says.
glideTime = hslider("[280]Glide_Time[group:Bass][export:Glide Time][unit:ms]", 35, 0, 500, 0.1) / 1000;

// Frets decides whether a glide walks up the frets or slides smoothly past
// them. Upstream fretted whenever Legato or a slide pad was active; this
// switch defaults ON, which is that same behaviour for every case that
// existed before it.
articulationFrets = button("Articulation_Frets") : ot.smoothParamFast;

// ── SCHWUNG PORT ADDITION (not upstream) ───────────────────────────────────
// ALTERNATE PICKING. Pick_Up is written by the host per note: 0 for a
// downstroke, 1 for an upstroke. It is deliberately NOT smoothed — it has to
// be correct at the instant the trigger edge lands, and a ramp between strokes
// would mean every pluck was half of each.
//
// Three things separate the two strokes, in descending order of how sure I am
// of them:
//
//   1. DIRECTION. The pick pushes the string one way going down and the other
//      going up, so the excitation goes in with the opposite sign. This is the
//      part that is simply true of a plucked string, and it is not cosmetic:
//      against a string that is still ringing, the two directions add and
//      cancel differently, which is where the groove of alternate picking
//      actually lives.
//   2. ENERGY. A downstroke gets arm weight and follow-through behind it; an
//      upstroke is a smaller motion. Down is the louder of the two.
//   3. TRANSIENT. Less pick surface catches the string on the way up, so the
//      click is thinner, brighter and shorter.
//
// ⚠ The AMOUNTS below are judgement, not measurement. They are deliberately
// modest — enough to hear across a line, not enough to sound like two
// different basses. Retune them here; each is one number.
pickUp = nentry("Pick_Up", 0, 0, 1, 1);

// Pick Depth scales how far apart the two strokes are: 100% is the voicing
// tuned by ear, 0% leaves only the direction, 200% is twice the separation.
//
// ⚠ It deliberately does NOT touch pickSign. The direction flip is the part
// that is physically true, and it is binary — scaling it as (1 - 2*k*up)
// would put the upstroke's excitation at ZERO around k = 0.5 and drop every
// other note. What scales is the three magnitudes, which are the parts that
// were judgement in the first place.
pickDepth = hslider("[290]Pick_Depth[group:Bass][export:Pick Depth][unit:%]", 100, 0, 200, 1) / 100;
pickAmount      = pickDepth * pickUp;    // 0 on any downstroke

pickSign        = 1 - 2 * pickUp;              // downstroke +1, upstroke -1
pickEnergy      = 1 - 0.18 * pickAmount;       // upstroke moves less string
pickClickDecay  = max(0.1, 1 - 0.38 * pickAmount);  // ... its click dies sooner
pickClickHP     = 300 + 240 * pickAmount;      // ... with less body
pickClickLP     = 3750 + 2600 * pickAmount;    // ... and more edge



eqBand1 = hslider("[410]EQ_Band_1[group:EQ][export:Band 1][unit:dB]", 0, -12, 12, 0.01) : ot.smoothParam;
eqBand2 = hslider("[420]EQ_Band_2[group:EQ][export:Band 2][unit:dB]", 0, -12, 12, 0.01) : ot.smoothParam;
eqBand3 = hslider("[430]EQ_Band_3[group:EQ][export:Band 3][unit:dB]", 0, -12, 12, 0.01) : ot.smoothParam;
eqBand4 = hslider("[440]EQ_Band_4[group:EQ][export:Band 4][unit:dB]", 0, -12, 12, 0.01) : ot.smoothParam;
eqBand5 = hslider("[450]EQ_Band_5[group:EQ][export:Band 5][unit:dB]", 0, -12, 12, 0.01) : ot.smoothParam;
