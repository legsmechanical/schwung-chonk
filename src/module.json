{
  "id": "chonk",
  "name": "CHONK",
  "abbrev": "CHNK",
  "version": "0.1.0",
  "description": "Physically modeled electric bass monosynth, ported from OneTrick CHONK (Punk Labs LLC). Waveguide string with movable pickup, finger/pick/slap styles, mute, legato, glide, slide and alternate picking. Ring release control, 5-band EQ and saturation. 9 factory presets.",
  "author": "legsmechanical (DSP: Punk Labs LLC)",
  "license": "GPL-3.0-or-later",
  "ui": "ui.js",
  "dsp": "dsp.so",
  "api_version": 2,
  "capabilities": {
    "audio_out": true,
    "audio_in": false,
    "midi_in": true,
    "midi_out": false,
    "aftertouch": true,
    "chainable": true,
    "component_type": "sound_generator"
  },
  "ui_hierarchy": {
    "modes": null,
    "levels": {
      "root": {
        "label": "CHONK",
        "list_param": "preset",
        "count_param": "preset_count",
        "name_param": "preset_name",
        "knobs": [
          "pickup",
          "bright",
          "tone",
          "thump",
          "sustain",
          "ring",
          "sat",
          "gain"
        ],
        "params": [
          "pickup",
          "bright",
          "tone",
          "thump",
          "sustain",
          "ring",
          {
            "level": "attack",
            "label": "Attack"
          },
          {
            "level": "fretting",
            "label": "Fretting"
          },
          {
            "level": "output",
            "label": "Output"
          },
          {
            "level": "midi",
            "label": "MIDI"
          }
        ]
      },
      "attack": {
        "name": "Attack",
        "knobs": [
          "style",
          "strike",
          "mute",
          "altpick",
          "depth"
        ],
        "params": [
          "style",
          "strike",
          "mute",
          "altpick",
          "depth"
        ]
      },
      "fretting": {
        "name": "Fretting",
        "knobs": [
          "legato",
          "glide",
          "glide_ms",
          "frets",
          "retrig"
        ],
        "params": [
          "legato",
          "glide",
          "glide_ms",
          "frets",
          "retrig"
        ]
      },
      "output": {
        "name": "Output",
        "knobs": [
          "gain",
          "pan",
          "sat",
          "eq1",
          "eq2",
          "eq3",
          "eq4",
          "eq5"
        ],
        "params": [
          "gain",
          "pan",
          "sat",
          "eq1",
          "eq2",
          "eq3",
          "eq4",
          "eq5"
        ]
      },
      "midi": {
        "name": "MIDI",
        "knobs": [
          "fine",
          "pw_range",
          "at_range",
          "sens"
        ],
        "params": [
          "fine",
          "pw_range",
          "at_range",
          "sens"
        ]
      }
    }
  }
}
